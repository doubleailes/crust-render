#usda 1.0
(
    doc = """A groom shaded through its curve mass field (hair_mass.mtlx): the
    left clump is baked into a field (`crust:mass:radius` = 0.45, three
    strand spacings) that its material reads — the mass colour, a root-to-tip
    ramp authored as the material's `outputs:crust:mass:color` terminal,
    blended with a per-strand colour, and the mass normal blended with the
    tube's under a `crust_mass_diffuse_bsdf`, both faded out by the mass
    density where the groom thins out into flyaways; a hair fibre on top for
    the specular. The right clump is the same strands shaded per strand
    (`strand_hair`), where crossing strands disagree on colour and normal.

    421 B-spline strands of 7 control points (the root tripled),
    generated by scripts/gen_hair_mass.py. Authored in centimetres
    (`metersPerUnit = 0.01`), as hair.usda is.

      cargo run --release -- render -i samples/hair_mass.usda -o hair_mass.exr
      cargo run --release -- check -i samples/hair_mass.usda
    """
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Scope "Render"
{
    def RenderSettings "settings"
    {
        rel camera = </World/Camera>
        uniform int2 resolution = (640, 400)
        int crust:samplesPerPixel = 64
    }
}

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "mass_hair" (
            prepend references = @hair_mass.mtlx@</MaterialX/Materials/mass_hair>
        )
        {
            color3f outputs:crust:mass:color.connect = </World/Looks/mass_hair/MassRamp.outputs:out>
            def Shader "Along"
            {
                uniform token info:id = "ND_geompropvalue_float"
                string inputs:geomprop = "curve:v"
                float outputs:out
            }
            def Shader "MassRamp"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.26, 0.11, 0.04)
                color3f inputs:fg = (0.72, 0.42, 0.16)
                float inputs:mix.connect = </World/Looks/mass_hair/Along.outputs:out>
                color3f outputs:out
            }
        }

        def Material "strand_hair" (
            prepend references = @hair_mass.mtlx@</MaterialX/Materials/strand_hair>
        )
        {
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "crust:openpbr"
                color3f inputs:baseColor = (0.35, 0.35, 0.34)
                float inputs:specularRoughness = 0.8
                token outputs:surface
            }
        }
    }

    def Camera "Camera"
    {
        float focalLength = 50
        float horizontalAperture = 36
        float verticalAperture = 22.5
        double3 xformOp:translate = (0, 5.5, 26)
        float3 xformOp:rotateXYZ = (-6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 0.6
    }

    def SphereLight "Key"
    {
        float inputs:intensity = 900
        float inputs:radius = 1.5
        double3 xformOp:translate = (-9, 14, 14)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "Rim"
    {
        float inputs:intensity = 400
        float inputs:radius = 1
        double3 xformOp:translate = (7, 10, -12)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-40, 0, -40), (-40, 0, 40), (40, 0, 40), (40, 0, -40)]
        rel material:binding = </World/Looks/Floor>
    }

    def Xform "Mass"
    {
        double3 xformOp:translate = (-3.2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    def BasisCurves "Groom" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token type = "cubic"
        uniform token basis = "bspline"
