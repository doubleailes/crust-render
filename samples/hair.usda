#usda 1.0
(
    doc = """MaterialX hair fixture: seven tufts of cubic Bézier strands, one per
    material of `hair.mtlx` — a bare `chiang_hair_bsdf`, roughness from
    `chiang_hair_roughness`, absorption from a colour and from melanin, the
    fibre mixed with a diffuse, a clear fibre, and the clear fibre's diffuse
    twin — over a grey floor, lit by the sky, a key light in front and a small
    light behind, so forward scattering shows as a rim glow on the fibres and
    not on the twin.

    Authored in centimetres (`metersPerUnit = 0.01`, the USD default): the
    tracer's absolute ray epsilon (0.001 units) is then 10 µm, below a hair's
    width, so neighbouring strands shadow and light each other.

      cargo run --release -- render -i samples/hair.usda -o hair.exr
    """
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "mtlx_hair_bare" (
            prepend references = @hair.mtlx@</MaterialX/Materials/mtlx_hair_bare>
        )
        {
        }

        def Material "mtlx_hair_roughness" (
            prepend references = @hair.mtlx@</MaterialX/Materials/mtlx_hair_roughness>
        )
        {
        }

        def Material "mtlx_hair_color" (
            prepend references = @hair.mtlx@</MaterialX/Materials/mtlx_hair_color>
        )
        {
        }

        def Material "mtlx_hair_melanin" (
            prepend references = @hair.mtlx@</MaterialX/Materials/mtlx_hair_melanin>
        )
        {
        }

        def Material "mtlx_hair_mix" (
            prepend references = @hair.mtlx@</MaterialX/Materials/mtlx_hair_mix>
        )
        {
        }

        def Material "mtlx_hair_clear" (
            prepend references = @hair.mtlx@</MaterialX/Materials/mtlx_hair_clear>
        )
        {
        }

        def Material "mtlx_diffuse_twin" (
            prepend references = @hair.mtlx@</MaterialX/Materials/mtlx_diffuse_twin>
        )
        {
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "crust:openpbr"
                color3f inputs:baseColor = (0.35, 0.35, 0.34)
                float inputs:specularRoughness = 0.8
                token outputs:surface
            }
        }
    }

