    def Mesh "Floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Floor>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-20, 0, -20), (-20, 0, 20), (20, 0, 20), (20, 0, -20)]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 0.3
        asset inputs:texture:file = @sky_gradient.exr@
        token inputs:texture:format = "latlong"
    }

    # In front, above the camera: the primary (R) and secondary (TRT)
    # highlights.
    def RectLight "Key"
    {
        float inputs:width = 3
        float inputs:height = 2
        float inputs:intensity = 6
        double3 xformOp:translate = (-2, 4, 6)
        float3 xformOp:rotateXYZ = (-30, -15, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    # Low behind the tufts: the forward-scattered (TT) rim glow.
    def SphereLight "Back"
    {
        float inputs:intensity = 400
        float inputs:radius = 0.15
        color3f inputs:color = (1, 0.92, 0.85)
        double3 xformOp:translate = (0, 1.2, -3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Cam"
    {
        float focalLength = 35
        float horizontalAperture = 36
        double3 xformOp:translate = (0, 1.1, 9)
        float xformOp:rotateX = -2
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        int2 resolution = (192, 64)
        int crust:samplesPerPixel = 16
        int crust:maxDepth = 8
        int crust:minSamplesPerPixel = 8
        float crust:varianceThreshold = 0.05
        int crust:frame = 0
    }
}
