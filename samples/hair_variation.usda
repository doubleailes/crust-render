#usda 1.0
(
    doc = """Per-strand variation through curve attributes: one groom of 48
    B-spline strands (each root point tripled, so the strand starts on
    the floor) whose MaterialX material reads, through `geompropvalue`,
    each curve's authored root colour (a `uniform` primvar), where on its
    strand a hit lies (`curve:v`, a root-to-tip ramp to blond) and a random
    value per curve (`curve:random`: a small hue shift through
    `rgbtohsv` / `hsvtorgb`, and one strand in ten grey via `ifgreater`).
    The colour drives `chiang_hair_absorption_from_color`.

    Authored in centimetres (`metersPerUnit = 0.01`), as `hair.usda` is.

      cargo run --release -- render -i samples/hair_variation.usda -o hair_variation.exr
    """
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "mtlx_hair_variation" (
            prepend references = @hair_variation.mtlx@</MaterialX/Materials/mtlx_hair_variation>
        )
        {
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.35, 0.35)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    def BasisCurves "Groom" (prepend apiSchemas = ["MaterialBindingAPI"])
