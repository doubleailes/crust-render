#usda 1.0
(
    doc = """Thin-walled transmission is a pass-through: two thin-walled sheets
    hang between a small sphere light and a grey floor — a native
    crust:openpbr tinted pane on the left and a MaterialX open_pbr_surface
    window on the right (`materialx_thin_walled.mtlx`) — and the floor under
    them is lit only through the sheets. Shadow rays are attenuated by each
    sheet's straight transmittance instead of blocked, so light sampling
    finds the light through the glass and the floor converges without
    fireflies.

      cargo run --release -- render -i samples/thin_window.usda -o window.exr --stats
      cargo run --release -- render -i samples/thin_window.usda -o light.exr --strategy light

    `--stats` counts the hits paths passed straight through.
    """
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Pane"
        {
            token outputs:surface.connect = </World/Looks/Pane/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "crust:openpbr"
                float inputs:transmissionWeight = 1
                color3f inputs:transmissionColor = (0.95, 0.55, 0.25)
                float inputs:specularIor = 1.5
                float inputs:specularRoughness = 0
                bool inputs:geometryThinWalled = 1
                token outputs:surface
            }
        }

        def Material "Window" (
            prepend references = @materialx_thin_walled.mtlx@</MaterialX/Materials/mtlx_openpbr_window>
        )
        {
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "crust:openpbr"
                color3f inputs:baseColor = (0.5, 0.5, 0.5)
                float inputs:specularRoughness = 0.8
                token outputs:surface
            }
        }
    }

    def Mesh "Pane" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Pane>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-6, 1.5, -6), (0, 1.5, -6), (0, 1.5, 6), (-6, 1.5, 6)]
    }

    def Mesh "Window" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Window>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(0, 1.5, -6), (6, 1.5, -6), (6, 1.5, 6), (0, 1.5, 6)]
    }

    def Mesh "Floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Floor>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-20, 0, -20), (20, 0, -20), (20, 0, 20), (-20, 0, 20)]
    }

    # Small and above the seam between the sheets: each lights the floor
    # under it through its own glass.
    def SphereLight "Key"
    {
        float inputs:intensity = 2500
        float inputs:radius = 0.08
        double3 xformOp:translate = (0, 3.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Under the sheets, looking down at the floor they shade.
    def Camera "ShotCam"
    {
        float focalLength = 24
        float horizontalAperture = 36
        double3 xformOp:translate = (0, 1.3, 5)
        float xformOp:rotateX = -20
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        int2 resolution = (480, 270)
        int crust:samplesPerPixel = 64
        int crust:maxDepth = 8
    }
}
