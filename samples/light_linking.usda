#usda 1.0
(
    doc = """Light and shadow linking, one light each:

- "Rim" includes only the hero ball (collection:lightLink:includeRoot = 0 plus
  includes): the other balls and the floor get none of it.
- "Fill" excludes the floor (collection:lightLink:excludes): the balls are
  filled, and the floor is lit by Key alone.
- "Key" excludes the pillar from its shadows (collection:shadowLink:excludes):
  the pillar stands between Key and the floor without shadowing it, but still
  shadows Fill and is seen by the camera.

Derived from light_visibility.usda."""
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Cam"
    {
        float focalLength = 24
        float horizontalAperture = 20.955
        double3 xformOp:translate = (0, 3, 9)
        float xformOp:rotateX = -12
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX"]
    }

    def Mesh "Floor"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-8, 0, -8), (8, 0, -8), (8, 0, 8), (-8, 0, 8)]
    }

    def Sphere "Left"
    {
        double radius = 0.7
        double3 xformOp:translate = (-2.5, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Hero"
    {
        double radius = 0.9
        double3 xformOp:translate = (0, 0.9, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Right"
    {
        double radius = 0.7
        double3 xformOp:translate = (2.5, 0.7, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Between Key and the floor in front of the balls.
    def Mesh "Pillar"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(1.05, 0, 2.05), (1.35, 0, 2.05), (1.35, 0, 2.35), (1.05, 0, 2.35), (1.05, 5, 2.05), (1.35, 5, 2.05), (1.35, 5, 2.35), (1.05, 5, 2.35)]
    }

    def SphereLight "Key"
    {
        float inputs:radius = 0.3
        color3f inputs:color = (1, 0.85, 0.6)
        float inputs:intensity = 60
        prepend rel collection:shadowLink:excludes = </World/Pillar>
        double3 xformOp:translate = (4, 5, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "Fill"
    {
        float inputs:radius = 0.6
        color3f inputs:color = (0.55, 0.7, 1)
        float inputs:intensity = 12
        prepend rel collection:lightLink:excludes = </World/Floor>
        double3 xformOp:translate = (-4, 3, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "Rim"
    {
        float inputs:radius = 0.3
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 80
        uniform bool collection:lightLink:includeRoot = 0
        prepend rel collection:lightLink:includes = </World/Hero>
        double3 xformOp:translate = (0, 3, -3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Scope "Render"
{
    def RenderSettings "settings"
    {
        int2 resolution = (160, 90)
        int crust:samplesPerPixel = 64
        int crust:maxDepth = 4
        int crust:minSamplesPerPixel = 16
        float crust:varianceThreshold = 0.05
        int crust:frame = 0
    }
}
